{
  "train_dataset": "data/font.csv",
  "validation_dataset": "data/font.csv",
  "activation": "logistic",
  "optimizer": "adam",
  "adam_beta1": 0.9,
  "adam_beta2": 0.999,
  "optimizer_epsilon": 1e-8,
  "eta": 0.001,
  "epochs": 30000,
  "batch_size": 32,
  "encoder_layers": [35, 20, 10],
  "latent_dim": 2,
  "seed": 1
}
